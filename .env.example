# Use the exact connection values shown by the Aiven service.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL_CA=
DB_CONNECT_TIMEOUT=10

# Optional application settings
SECRET_KEY=replace-with-a-long-random-value
# Set this in Render or your local environment; never expose it in frontend code.
OPENROUTER_FINSIGHTAI_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GROQ_TIMEOUT=25
MAX_CONTENT_LENGTH=16777216
MAX_DATA_COLUMNS=200
MAX_DATA_ROWS=1000000
ALLOWED_EXTENSIONS=csv,xlsx,xls,json
UPLOAD_FOLDER=uploads
POWERBI_ROOT=users
POWERBI_TEMPLATE=finsightai.pbix
